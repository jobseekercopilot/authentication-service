# Copying this file directly is intentionally insufficient: blank secrets are rejected.
# Generate a private local value with: ./scripts/generate-local-signing-key.sh
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
# Comma-separated kid=base64-X.509-public-key entries during rotation only.
JWT_PREVIOUS_PUBLIC_KEYS=
AUTH_DB_PASSWORD=
AUTH_SERVICE_TOKEN=
AUTH_ENVIRONMENT_DATA_TOKEN=
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_ISSUER=job-seeker-copilot-authentication
JWT_AUDIENCE=job-seeker-copilot-services
JWT_KEY_ID=local-primary
JWT_CLOCK_SKEW_SECONDS=30
AUTH_REFRESH_TOKEN_LIFETIME=7d
AUTH_LOGIN_MAXIMUM_FAILURES=10
AUTH_LOGIN_ATTEMPT_WINDOW=15m
AUTH_LOGIN_LOCK_DURATION=15m
AUTH_LOGIN_MAXIMUM_TRACKED_PRINCIPALS=10000
